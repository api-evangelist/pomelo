{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pomelo Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an OAuth 2.0 access token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pomelo.la/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange client credentials for a Bearer access token (JWT) using the client_credentials grant. Issued against https://auth.pomelo.la. The same token is returned until it expires, after which a new one is issued."
        }
      ]
    }
  ],
  "bundled": true
}