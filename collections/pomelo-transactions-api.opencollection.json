{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pomelo Authentication Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search transactions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pomelo.la/transactions/v1",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "card_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search processed card transactions by user, card, date range, or status."
        },
        {
          "info": {
            "name": "Get a transaction.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pomelo.la/transactions/v1/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a transaction."
        }
      ]
    }
  ],
  "bundled": true
}