            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Move funds between card accounts to fund or reconcile the program."
        },
        {
          "info": {
            "name": "Get a transfer.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pomelo.la/transfers/v1/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
